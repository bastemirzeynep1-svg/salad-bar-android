<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:background="#E8F5E9" android:padding="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🥗 The Fresh Bowl" android:textSize="32sp" android:textStyle="bold" android:textColor="#1B5E20"/>
    
    <TextView android:id="@+id/scoreText" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Score: 0" android:textSize="24sp" android:textStyle="bold" android:textColor="#2E7D32" android:layout_marginTop="10dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Customer Order:" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="30dp" android:textColor="#E65100"/>
    
    <TextView android:id="@+id/orderText" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🥬 🍅" android:textSize="40sp" android:layout_marginBottom="30dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Your Bowl:" android:textSize="20sp" android:textStyle="bold" android:textColor="#424242"/>
    
    <TextView android:id="@+id/plateText" android:layout_width="match_parent" android:layout_height="80dp"
        android:text="" android:textSize="40sp" android:background="#FFFFFF" android:gravity="center" android:layout_marginBottom="20dp"/>

    <GridLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:columnCount="3" android:rowCount="2">
        <Button android:id="@+id/btn1" android:text="🥬" android:textSize="30sp" android:layout_margin="5dp"/>
        <Button android:id="@+id/btn2" android:text="🍅" android:textSize="30sp" android:layout_margin="5dp"/>
        <Button android:id="@+id/btn3" android:text="🥒" android:textSize="30sp" android:layout_margin="5dp"/>
        <Button android:id="@+id/btn4" android:text="🥕" android:textSize="30sp" android:layout_margin="5dp"/>
        <Button android:id="@+id/btn5" android:text="🧀" android:textSize="30sp" android:layout_margin="5dp"/>
        <Button android:id="@+id/btnServe" android:text="SERVE" android:textSize="18sp" android:textStyle="bold" android:backgroundTint="#4CAF50" android:textColor="#FFFFFF" android:layout_margin="5dp"/>
    </GridLayout>
    
    <Button android:id="@+id/btnClear" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="CLEAR BOWL" android:textStyle="bold" android:backgroundTint="#EF5350" android:textColor="#FFFFFF" android:layout_marginTop="20dp"/>
        
</LinearLayout>
